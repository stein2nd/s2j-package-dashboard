{
    "extends": [
        "./node_modules/@s2j/docs-linter/presets/base/.textlintrc.base.json"
    ],
    "plugins": {},
    "filters": {
        "allowlist": {
            "allow": [
                "/\\s>\\s/",
                "/リファラー/",
                "/エントリー/",
                "/エントリ/",
                "/(?<!プ)レイヤー/",
                "/(?<!プレ)レイヤ(?!ー)/",
                "/ローダー/",
                "/スクロール/",
                "/ロールバック/",
                "/の分担/",
                "/@wordpress\\/[a-zA-Z0-9@._/-]*/i",
                "/[.。]\\s*「/u"
            ]
        }
    },
    "rules": {
        "preset-wp-docs-ja": true,
        "prh": {
            "rulePaths": [
                "./node_modules/textlint-rule-preset-swift-docs-ja/prh-rules/swift.yml"
            ],
            "severity": "warning"
        }
    }
}
